{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "types": ["vitest/globals", "vite/client", "@vitest/browser/providers/playwright"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", ".storybook/*.ts", "vitest.config.ts"]
}
